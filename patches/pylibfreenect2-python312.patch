         pyparams.params = params
         return pyparams
 
+    def setDepthConfiguration(self, float minimum, float maximum,
+                              bool bilateral=True, bool edge_aware=True):
+        if minimum < 0 or maximum <= minimum:
+            raise ValueError("Depth range must have 0 <= minimum < maximum")
+        cdef _Freenect2Device.Config config = _Freenect2Device.Config()
+        config.MinDepth = minimum
+        config.MaxDepth = maximum
+        config.EnableBilateralFilter = bilateral
+        config.EnableEdgeAwareFilter = edge_aware
+        self.ptr.setConfiguration(config)
+
+    def setColorAutoExposure(self, float compensation=0):
+        if not -2 <= compensation <= 2:
+            raise ValueError("Exposure compensation must be between -2 and 2")
+        self.ptr.setColorAutoExposure(compensation)
+
+    def setColorSemiAutoExposure(self, float milliseconds):
+        if not 0 < milliseconds <= 640:
+            raise ValueError("Semi-auto exposure must be between 0 and 640 ms")
+        self.ptr.setColorSemiAutoExposure(milliseconds)
+
+    def setColorManualExposure(self, float milliseconds, float gain):
+        if not 0 < milliseconds <= 66 or not 1 <= gain <= 4:
+            raise ValueError("Manual exposure requires 0 < ms <= 66 and 1 <= gain <= 4")
+        self.ptr.setColorManualExposure(milliseconds, gain)
+
+    def setLedStatus(self, int led_id, int level, int stop_level=0,
+                     int interval_ms=0):
+        if led_id not in (0, 1) or not 0 <= level <= 1000 or not 0 <= stop_level <= 1000:
+            raise ValueError("LED id must be 0 or 1 and levels must be 0..1000")
+        if interval_ms < 0:
+            raise ValueError("Blink interval cannot be negative")
+        cdef libfreenect2.LedSettings led
+        led.LedId = led_id
+        led.Mode = 1 if interval_ms else 0
+        led.StartLevel = level
+        led.StopLevel = stop_level
+        led.IntervalInMs = interval_ms
+        led.Reserved = 0
+        self.ptr.setLedStatus(led)
+

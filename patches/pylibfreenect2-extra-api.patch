+cdef class Freenect2Replay:
+    """Replay libfreenect2 raw packet recordings (not app .npz snapshots).
+
+    Native replay currently processes .depth packets only; it does not decode
+    .jpg files or support startStreams(). Supply the matching camera calibration
+    and raw packet tables before relying on replayed depth values.
+    """
+    cdef libfreenect2.Freenect2Replay* ptr
+
+    def __cinit__(self):
+        self.ptr = new libfreenect2.Freenect2Replay()
+
+    def __dealloc__(self):
+        if self.ptr is not NULL:
+            del self.ptr
+
+    def openDevice(self, filenames, PacketPipeline pipeline=None):
+        filenames = [str(path) for path in filenames]
+        if not filenames:
+            raise ValueError("Replay requires raw frame filenames")
+        if any(not path.endswith(".depth") for path in filenames):
+            raise ValueError("Native replay only processes raw .depth packet files")
+        cdef vector[string] paths = [path.encode() for path in filenames]
+        cdef _Freenect2Device* dev_ptr
+        if pipeline is None:
+            dev_ptr = self.ptr.openDevice(paths)
+        else:
+            dev_ptr = self.ptr.openDevice(paths, pipeline.pipeline_ptr_alias)
+        if dev_ptr == NULL:
+            raise RuntimeError("Unable to open replay device")
+        if pipeline is not None:
+            pipeline.owned_by_device = True
+        cdef Freenect2Device device = Freenect2Device()
+        device.ptr = dev_ptr
+        device.owner = self
+        return device

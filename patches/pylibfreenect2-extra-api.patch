diff --git a/tests/test_extended_api.py b/tests/test_extended_api.py
new file mode 100644
--- /dev/null
+++ b/tests/test_extended_api.py
@@ -0,0 +1,44 @@
+"""Boundary checks for the local libfreenect2 binding extensions."""
+
+import unittest
+
+from pylibfreenect2 import ColorSettingCommand, FrameFormat, FrameMap, Freenect2, Freenect2Device, Freenect2Replay
+
+
+class ExtendedBindingTests(unittest.TestCase):
+    def test_missing_frame_does_not_insert_null_native_pointer(self):
+        frames = FrameMap()
+        with self.assertRaises(KeyError):
+            frames["color"]
+        with self.assertRaises(KeyError):
+            frames["depth"]
+
+    def test_empty_replay_is_rejected(self):
+        with self.assertRaises(ValueError):
+            Freenect2Replay().openDevice([])
+        with self.assertRaises(ValueError):
+            Freenect2Replay().openDevice(["snapshot.npz"])
+
+    def test_color_commands_validate_before_native_call(self):
+        self.assertEqual(FrameFormat.BGRX, 4)
+        self.assertEqual(ColorSettingCommand.GET_FRAME_RATE, 83)
+        self.assertEqual(ColorSettingCommand.SET_EXPOSURE_METERING_ZONE_47_WEIGHT, 76)
+        device = Freenect2Device()
+        with self.assertRaises(ValueError):
+            device.setColorSetting(9, 0)
+        with self.assertRaises(ValueError):
+            device.setColorSetting(11, -1)
+        with self.assertRaises(ValueError):
+            device.getColorSetting(84)
+
+    def test_at_least_one_stream_is_required(self):
+        with self.assertRaises(ValueError):
+            Freenect2Device().startStreams(False, False)
+
+    def test_unicode_serial_is_encoded_for_native_open(self):
+        with self.assertRaises(RuntimeError):
+            Freenect2().openDevice("serial-not-enumerated")
+
+
+if __name__ == "__main__":
+    unittest.main()
